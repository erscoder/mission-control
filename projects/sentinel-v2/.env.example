# Sentinel V2 Environment Configuration

# MiniMax LLM
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# Jina AI Embeddings (lightweight, free tier: 100K tokens/month)
# Get one at: https://jina.ai/embeddings
JINA_API_KEY=your_jina_api_key_here

# Ollama (NOT recommended for embeddings - too resource intensive)
# Keeping this for reference, but Jina is preferred
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=locusai/all-minilm-l6-v2

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Approval Timeout (seconds)
SENTINEL_APPROVAL_TIMEOUT_SECONDS=3600
SENTINEL_APPROVAL_POLL_INTERVAL=5
