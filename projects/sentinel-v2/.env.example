# Sentinel V2 - Environment Variables

# OpenAI API Key (for LLM)
# CrewAI will use this for gpt-4o / gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-api-key-here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Telegram Chat ID (Kike's chat ID - use @userinfobot to get it)
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Sentinel Loop Configuration
SENTINEL_LOOP_INTERVAL_HOURS=1  # How often to run the loop (hours)
SENTINEL_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
SENTINEL_ONCE=0  # Set to 1 to run once instead of loop (daemon mode only)

# Memory Configuration (LanceDB is default)
# CREWAI_MEMORY_STORAGE=lancedb
# CREWAI_MEMORY_PATH=./.crewai/memory

# Optional: Override LLM models
# CREWAI_LLM=gpt-4o
# CREWAI_MANAGER_LLM=gpt-4o

# ─── Ollama (alternative to OpenAI) ───────────────────────────────────────────
# Use Ollama as LLM provider instead of OpenAI (avoids quota issues)
# Requires Ollama running on localhost:11434
#
# Setup:
#   1. Install Ollama: brew install ollama
#   2. Pull model: ollama pull qwen2.5:1.5b
#   3. Run: ollama serve
#
# Set TEST_OLLAMA=1 to run e2e tests with Ollama:
#   TEST_OLLAMA=1 uv run pytest tests/e2e/ -v

TEST_OLLAMA=0  # Set to 1 to enable Ollama for e2e tests
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
